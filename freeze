busy = false

freezeBtn.MouseButton1Click:Connect(function()
    if busy then
        return
    end

    busy = true

    pcall(function()
        (TweenService:Create(freezeBtn, TweenInfo.new(0.3), {
            BackgroundColor3 = Color3.fromRGB(255, 160, 40),
        })):Play()
    end)

    freezeBtn.BackgroundColor3 = Color3.fromRGB(255, 160, 40)
    statusDot.BackgroundColor3 = Color3.fromRGB(255, 180, 50)
    statusGlow.BackgroundColor3 = Color3.fromRGB(255, 180, 50)
    statusText.Text = 'Working'
    statusText.TextColor3 = Color3.fromRGB(255, 180, 50)

    for i = 1, 3, 1 do
        freezeBtn.Text = 'FREEZING' .. string.rep('.', i)

        wait(2)
    end

    pcall(function()
        (TweenService:Create(freezeBtn, TweenInfo.new(0.3), {
            BackgroundColor3 = Color3.fromRGB(255, 45, 45),
        })):Play()
    end)

    freezeBtn.BackgroundColor3 = Color3.fromRGB(255, 45, 45)
    freezeBtn.Text = 'FREEZE'
    statusDot.BackgroundColor3 = Color3.fromRGB(45, 255, 95)
    statusGlow.BackgroundColor3 = Color3.fromRGB(45, 255, 95)
    statusText.Text = 'Ready'
    statusText.TextColor3 = Color3.fromRGB(45, 255, 95)
    busy = false
end)
